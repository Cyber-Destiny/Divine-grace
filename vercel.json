{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "divine-grace-blue.vercel.app" }],
      "destination": "https://divinegracehotel.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "divine-grace-blue.vercel.app" }],
      "destination": "https://divinegracehotel.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    }
  ]
}
